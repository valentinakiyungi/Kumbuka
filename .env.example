# Copy to .env and fill in. Without a key Kumbuka runs in offline demo mode.
GEMINI_API_KEY=

# Chat models, tried in order (the first one that works is kept)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash
# EMBED_MODEL=gemini-embedding-001
# VECTOR_SIZE=768

# Long-term memory: leave unset for local files in ./data/qdrant
# QDRANT_URL=https://xxxx.cloud.qdrant.io
# QDRANT_API_KEY=
# RECALL_THRESHOLD=0.55
# RECALL_LIMIT=4

# Session memory + compression
# KUMBUKA_DB=./data/kumbuka.db
# HISTORY_WINDOW=8
# KEEP_RECENT=4
# SUMMARY_MAX_CHARS=1200

# Abuse protection
# CHAT_PER_HOUR=60
